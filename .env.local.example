# ===== WordPress AWS Platform - Local Development =====
# Copy this file to packages/frontend/.env.local

# ===== Frontend API Configuration =====
# In dev: leave empty to use Next.js API routes with mock data
# In prod: set to your API Gateway URL from CDK outputs
NEXT_PUBLIC_API_URL=/api

# Backend API Gateway URL (server-side only, used by proxy)
# Get this from: cd infrastructure && npm run outputs
# BACKEND_API_URL=https://xxxxxxxxxx.execute-api.af-south-1.amazonaws.com/dev/api/v1

# ===== AWS Cognito =====
# Get these from CDK outputs after deploy
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=

# ===== WebSocket (real-time tracking/hailing) =====
# NEXT_PUBLIC_WS_URL=wss://xxxxxxxxxx.execute-api.af-south-1.amazonaws.com/dev

# ===== Paystack (Payment Gateway) =====
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

# ===== Feature Flags =====
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_HAILING=true
NEXT_PUBLIC_ENABLE_SPACES=true

# ===== S3 Buckets (from CDK outputs) =====
# MEDIA_BUCKET_NAME=wp-platform-media-dev
# LABELS_BUCKET_NAME=wp-platform-labels-dev
