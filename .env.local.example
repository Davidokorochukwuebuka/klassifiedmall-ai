# Frontend Environment Variables
# Copy this to .env.local and fill in your values after CDK deployment

# API Gateway URL (from CDK output after deployment)
NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev

# WebSocket URL (from CDK output)
NEXT_PUBLIC_WEBSOCKET_URL=wss://your-ws-id.execute-api.us-east-1.amazonaws.com/dev

# Cognito (from CDK output)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-client-id
NEXT_PUBLIC_COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com

# Paystack (public key only - safe for frontend)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_key

# App
NEXT_PUBLIC_APP_NAME=KlASSIFIED
NEXT_PUBLIC_APP_URL=http://localhost:3000
